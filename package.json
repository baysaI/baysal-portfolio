{
  "name": "baysai-portfolio",
  "private": true,
  "version": "0.1.0",
  "description": "Baysai — immersive 3D portfolio built with Three.js, GSAP and Lenis.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "gsap": "3.15",
    "lenis": "1.3",
    "three": "^0.187.0"
  }
}
